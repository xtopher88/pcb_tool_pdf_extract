# LLM backend for the profile step: openai | claude | claude-code
DATASHEET_BACKEND=openai
DATASHEET_MODEL=gpt-5.4

# Thinking effort for the 'claude' backend: low | medium | high | xhigh | max
# Default 'high' (the API default). 'medium' is the first cost lever to try -
# schema-guided extraction rarely needs 'high'. Ignored by other backends.
DATASHEET_EFFORT=high

# API keys (only the one matching your backend is needed; claude-code needs none)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pipeline directories (defaults: siblings of this repo)
# PDF_WORKSPACE=C:/Projects/opensource
# PDF_INPUT_DIR=C:/Projects/opensource/pdf_input
# PDF_STEP1_DIR=C:/Projects/opensource/pdf_step1
# PDF_OUTPUT_DIR=C:/Projects/opensource/pdf_output
